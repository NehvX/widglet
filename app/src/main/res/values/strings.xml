    <!-- Onboarding -->
    <string name="onb_title">Welcome to Widglet</string>
    <string name="onb_intro">Put your favourite photos on your home screen, change them on your schedule, and even cut out the subject so it pops in front of a clock.</string>
    <string name="onb_readonly_t">Your gallery stays untouched</string>
    <string name="onb_readonly">Widglet only ever reads your photos. It never deletes, moves, edits or re-saves anything in your gallery. Cutouts and caches live in Widglet\'s private storage.</string>
    <string name="onb_perm_t">Photo access</string>
    <string name="onb_perm">To list your albums Widglet asks to read photos. On Android 14+ you can allow only selected photos; Widglet works with that too.</string>
    <string name="onb_privacy_t">Private by design</string>
    <string name="onb_privacy">No network permission, no analytics, no ads, no accounts. All processing (including background removal) happens on your phone.</string>
    <string name="onb_allow">Allow photo access</string>
    <string name="onb_picker_only">Continue without (hand-pick photos only)</string>
    <string name="onb_picker_note">Hand-picking photos uses the system Photo Picker and needs no permission.</string>

