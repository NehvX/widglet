<?xml version="1.0" encoding="utf-8"?>
<!-- One frame of the widget: back image, live clock (optional), front cutout (optional).
     Putting the clock between the photo and the cutout gives the "subject in front of the clock" depth look. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/back"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:id="@+id/clock_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="top|center_horizontal"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextClock
            android:id="@+id/clock_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:shadowColor="#66000000"
            android:shadowRadius="6"
            android:textColor="#FFFFFFFF"
            android:textSize="56sp" />

        <TextClock
            android:id="@+id/clock_time_mono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:shadowColor="#66000000"
            android:shadowRadius="6"
            android:textColor="#FFFFFFFF"
            android:textSize="56sp"
            android:visibility="gone" />

        <TextClock
            android:id="@+id/clock_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEE, d MMM"
            android:format24Hour="EEE, d MMM"
            android:shadowColor="#66000000"
            android:shadowRadius="4"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/front"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:visibility="gone" />
</FrameLayout>
