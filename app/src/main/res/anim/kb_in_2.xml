<?xml version="1.0" encoding="utf-8"?>
<!-- Ken Burns: fade in, then a slow zoom that holds its end state until the next photo. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:fillAfter="true" android:fillEnabled="true">
    <alpha android:duration="500" android:fromAlpha="0" android:toAlpha="1" />
    <scale android:duration="20000" android:fromXScale="1" android:fromYScale="1" android:toXScale="1.15" android:toYScale="1.15" android:pivotX="40%" android:pivotY="45%" android:interpolator="@android:interpolator/linear" />
</set>
